{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "env": {
    "PUBLIC_ORIGIN": "https://horse-power.vercel.app",
    "APP_ORIGINS": "https://horse-power.vercel.app,https://oficinahorsepower.com.br,https://sistema.oficinahorsepower.com.br"
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "yul1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "server/db/certs/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "oficinahorsepower.com.br"
        }
      ],
      "destination": "/site/index.html"
    },
    {
      "source": "/contato",
      "has": [
        {
          "type": "host",
          "value": "oficinahorsepower.com.br"
        }
      ],
      "destination": "/site/contato.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/p/:token",
      "destination": "/client.html"
    },
    {
      "source": "/((?!api/|assets/|brand/|downloads/|site/|favicon|privacidade\\.html$).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/contato.html",
      "has": [
        {
          "type": "host",
          "value": "oficinahorsepower.com.br"
        }
      ],
      "destination": "/contato",
      "permanent": true
    }
  ]
}
